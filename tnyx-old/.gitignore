# ============================================================

.env
.env.*
!.env.example

# Local credentials/configuration
*.local
*.secret
*.secrets

# ============================================================
# Tnyx local vault/user data
# ============================================================

# Do NOT accidentally commit real password vaults.
/*.vault
/*.tnyx

# Backups / temporary vault copies
/*.vault.*
/*.tnyx.*